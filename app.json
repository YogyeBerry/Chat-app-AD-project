{
  "expo": {
    "name": "ChatApp",
    "slug": "chat-app-ad-project",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.yogyeberry.chatapp",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ChatApp to access your camera to take and send photos in chat."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ChatApp to access your photo library to share images in chat."
        }
      ]
    ]
  }
}
